  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:server\"",
    "dev:vite": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production node dist-server/server/index.js",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:unit": "vitest run --project unit",
    "test:hooks": "vitest run --project hooks",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:concurrency": "vitest run --project concurrency",
    "test:jobs": "vitest run --project jobs",
    "test:db": "vitest run --project integration --project security --project concurrency --project jobs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
